{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "sample-dev-01"
		},
		"ls_adls_lake_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stairqualitydev01.dfs.core.windows.net/"
		},
		"ls_http_openaq_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://api.openaq.org/"
		},
		"ls_http_openmeteo_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://api.open-meteo.com/"
		},
		"ls_http_openmeteo_archive_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://archive-api.open-meteo.com/"
		},
		"ls_sql_config_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-airquality-dev-01.database.windows.net"
		},
		"ls_sql_config_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqldb-airquality-config"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "sample-dev-01_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_adls_lake_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_lake_properties_typeProperties_url')]"
					},
					"ls_http_openaq_properties_typeProperties_url": {
						"value": "[parameters('ls_http_openaq_properties_typeProperties_url')]"
					},
					"ls_http_openmeteo_properties_typeProperties_url": {
						"value": "[parameters('ls_http_openmeteo_properties_typeProperties_url')]"
					},
					"ls_http_openmeteo_archive_properties_typeProperties_url": {
						"value": "[parameters('ls_http_openmeteo_archive_properties_typeProperties_url')]"
					},
					"ls_sql_config_properties_typeProperties_server": {
						"value": "[parameters('ls_sql_config_properties_typeProperties_server')]"
					},
					"ls_sql_config_properties_typeProperties_database": {
						"value": "[parameters('ls_sql_config_properties_typeProperties_database')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}