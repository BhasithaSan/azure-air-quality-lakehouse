{
	"name": "pl_ingest_openmeteo_single",
	"properties": {
		"activities": [
			{
				"name": "copy_openmeteo_to_bronze",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "BinarySource",
						"storeSettings": {
							"type": "HttpReadSettings",
							"requestMethod": "GET"
						},
						"formatSettings": {
							"type": "BinaryReadSettings"
						}
					},
					"sink": {
						"type": "BinarySink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "ds_http_openmeteo_bin",
						"type": "DatasetReference",
						"parameters": {
							"latitude": {
								"value": "@pipeline().parameters.latitude",
								"type": "Expression"
							},
							"longitude": {
								"value": "@pipeline().parameters.longitude",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_adls_bronze_bin",
						"type": "DatasetReference",
						"parameters": {
							"folder_path": {
								"value": "@concat('open_meteo/', pipeline().parameters.city, '/', formatDateTime(pipeline().TriggerTime, 'yyyy/MM/dd'))",
								"type": "Expression"
							},
							"file_name": {
								"value": "@concat('weather_', pipeline().parameters.city, '_', formatDateTime(pipeline().TriggerTime, 'yyyyMMdd_HHmmss'), '.json')",
								"type": "Expression"
							}
						}
					}
				]
			}
		],
		"parameters": {
			"city": {
				"type": "string",
				"defaultValue": "colombo"
			},
			"latitude": {
				"type": "string",
				"defaultValue": "6.93"
			},
			"longitude": {
				"type": "string",
				"defaultValue": "79.85"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-09-19T16:35:26Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}