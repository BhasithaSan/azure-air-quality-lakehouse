{
	"name": "pl_master_openaq",
	"properties": {
		"activities": [
			{
				"name": "lkp_get_cities",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT\n    CAST(s.sensor_id AS VARCHAR(20))                                  AS sensor_id,\n    s.city_name,\n    CONVERT(VARCHAR(10), DATEADD(DAY, 1, s.last_loaded_date), 23)     AS start_date,\n    CONVERT(VARCHAR(10), w.end_date, 23)                              AS end_date,\n    CONVERT(VARCHAR(10), DATEADD(DAY, 1, w.end_date), 23)             AS datetime_to\nFROM dbo.config_openaq_sensors AS s\nCROSS APPLY (\n    SELECT CASE\n        WHEN DATEADD(DAY, 30, s.last_loaded_date) < DATEADD(DAY, -1, CAST(GETUTCDATE() AS DATE))\n        THEN DATEADD(DAY, 30, s.last_loaded_date)\n        ELSE DATEADD(DAY, -1, CAST(GETUTCDATE() AS DATE))\n    END AS end_date\n) AS w\nWHERE s.is_active = 1\n  AND DATEADD(DAY, 1, s.last_loaded_date) <= w.end_date;",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_sql_config",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "foreach_city",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "lkp_get_cities",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('lkp_get_cities').output.value",
						"type": "Expression"
					},
					"isSequential": false,
					"batchCount": 4,
					"activities": [
						{
							"name": "run_single_city",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "pl_ingest_openaq_sensor",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"sensor_id": {
										"value": "@item().sensor_id",
										"type": "Expression"
									},
									"city": {
										"value": "@item().city_name",
										"type": "Expression"
									},
									"start_date": {
										"value": "@item().start_date",
										"type": "Expression"
									},
									"end_date": {
										"value": "@item().end_date",
										"type": "Expression"
									},
									"datetime_to": {
										"value": "@item().datetime_to",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			}
		],
		"annotations": [],
		"lastPublishTime": "2026-09-20T13:57:04Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}