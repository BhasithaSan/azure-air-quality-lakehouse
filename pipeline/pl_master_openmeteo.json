								},
								"waitOnCompletion": true,
								"parameters": {
									"city": {
										"value": "@item().city_name",
										"type": "Expression"
									},
									"latitude": {
										"value": "@string(item().latitude)",
										"type": "Expression"
									},
									"longitude": {
										"value": "@string(item().longitude)",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			}
		],
