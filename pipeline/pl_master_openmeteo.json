{
	"name": "pl_master_openmeteo",
	"properties": {
		"activities": [
			{
				"name": "lkp_get_cities",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
