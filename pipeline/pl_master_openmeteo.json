					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "    SELECT city_name, latitude, longitude\n    FROM dbo.config_cities\n    WHERE is_active = 1",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_sql_config",
						"type": "DatasetReference"
